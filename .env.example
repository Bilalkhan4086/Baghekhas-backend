# Neon PostgreSQL connection string. NEON_DB_CONNECTION is also accepted.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
# Rider phone/password sessions use a separate JWT audience and rotating refresh sessions.
RIDER_JWT_ACCESS_TOKEN_MINUTES=480
RIDER_REFRESH_TOKEN_DAYS=7

# Keep disabled until the Backend, RiderApp, and Admin Panel compatibility release is deployed.
RIDER_ROUTE_WORKFLOW_ENABLED=false
# Server-side Google Route Optimization API project. Heroku can provide a Base64-encoded service
# account JSON key; leave it unset locally to preserve ADC/workload-identity authentication.
GOOGLE_CLOUD_PROJECT_ID=replace-with-your-google-cloud-project-id
# GOOGLE_ROUTE_OPTIMIZATION_CREDENTIALS_BASE64=replace-with-base64-service-account-json
ROUTE_OPTIMIZATION_TIMEOUT_SECONDS=10

# Comma-separated exact browser origins. Keep empty for server-to-server only.
# Admin Vite development origins. The API also automatically allows the customer storefront
# at http://localhost:3000 when ENVIRONMENT=development.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DELIVERY_CUTOFF_HOUR=15
# Default promised delivery time in Asia/Karachi (24-hour HH:MM).
DELIVERY_DEFAULT_TIME=18:00
MAX_REQUEST_BODY_BYTES=1048576
LOGIN_REQUESTS_PER_MINUTE=10
PUBLIC_ORDER_REQUESTS_PER_MINUTE=30

# Server-only credentials used to sign direct product-image uploads.
AWS_ACCESS_KEY_ID=replace-with-an-iam-access-key
AWS_SECRET_ACCESS_KEY=replace-with-an-iam-secret-key
AWS_STORAGE_BUCKET_NAME=replace-with-your-bucket-name
AWS_S3_URL=https://replace-with-your-public-bucket-or-cdn-url
S3DIRECT_REGION=replace-with-your-aws-region
# Optional; allowed range is 60-900 seconds.
S3_PRESIGNED_URL_EXPIRATION_SECONDS=300

# Used only by `bagh-api create-admin`.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
